<script>/* Fehler des Bureau mitschreiben, bevor irgendetwas anderes läuft: liest die Prüfung (pruefung.html). Wie Grand Beau-Rivage (15.10.2026):
   Netzfehler nie melden (Safari meldete sonst die eigene gescheiterte Meldung in einer Schleife), höchstens 20 je Seite. */
(function(){var zahl=0;function merk(t){t=String(t);if(++zahl>20||/Load failed|access control|abort|NetworkError/i.test(t))return;
try{var a=JSON.parse(localStorage.getItem('ce_fehler')||'[]');a.push({zeit:new Date().toLocaleString('de-CH'),wo:'Bureau',text:t.slice(0,300)});localStorage.setItem('ce_fehler',JSON.stringify(a.slice(-12)))}catch(e){}
try{fetch('/control/api/b/fehler',{method:'POST',headers:{'Content-Type':'application/json','X-Studio':'1'},body:JSON.stringify({text:t.slice(0,600)}),keepalive:true}).catch(function(){})}catch(e){}}
window.addEventListener('error',function(e){merk((e.message||'Fehler')+' · '+(e.filename||'').split('/').pop()+':'+(e.lineno||''))});
window.addEventListener('unhandledrejection',function(e){merk('Versprechen: '+((e.reason&&e.reason.message)||e.reason))});window.bureauMerk=merk})();</script>
</head>
