#!/usr/bin/env python3
"""Le Livre · Carlton-Europe, Server-Teil (Nachbau von livre.py des Grand Beau-Rivage, dort nur gelesen). Aufgerufen von server.py unter
/_werkzeuge/livre/api/<was>:

   GET  bild?k=<foto>&f=instagram|story|web|druck[&y=0..1][&x=0..1]   das Foto in fertiger Grösse als Download
   GET  stand                                                           Zahlen für La Maison (Fotos, Dateien)
   POST pruefen  {name, typ, daten (data-URL), sprache}                 Markenprüfung eines Entwurfs

Farben werden ohne KI gemessen (gegen die Palette aus assets/css/main.css, Abstand nach CIEDE2000, siehe _werkbank/marke_daten.py); Bild, Schrift, Zeichen
und Ton beurteilt Claude (Schlüssel aus dem Vault, wie bei der Rezeption). Gespeichert wird nichts: der Entwurf lebt nur im Arbeitsspeicher und in einem
Zwischenordner, der nach der Antwort gelöscht wird. Die Bildliste baut _werkbank/marke_livre.py nach marke/livre.json."""
import base64, io, json, math, os, re, shutil, subprocess, sys, tempfile, time, urllib.request, urllib.error
from functools import lru_cache
from PIL import Image, ImageOps, ImageFile, ImageFilter, ImageChops

ImageFile.LOAD_TRUNCATED_IMAGES = True
Image.MAX_IMAGE_PIXELS = None
HIER = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HIER))
# Lokal liest Le Livre die Marke aus der Website (marke_daten, Originale aus _quelle mit den überarbeiteten Fassungen über ki_quelle).
# Online (Vercel, api/_lib/livre/) gibt es beides nicht: dann kommt alles aus marke/livre.json (Kopie neben dieser Datei), Fotos aus der Website.
if os.path.isdir(os.path.join(ROOT, '_werkbank')):
    sys.path.insert(0, os.path.join(ROOT, '_werkbank'))
    sys.path.insert(0, ROOT)
try:
    import marke_daten as D  # noqa: E402
except ImportError:
