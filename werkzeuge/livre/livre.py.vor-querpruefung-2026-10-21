LIVRE_JSON = next((x for x in (os.environ.get('LIVRE_JSON'), os.path.join(HIER, 'livre.json'), os.path.join(ROOT, 'marke', 'livre.json')) if x and os.path.exists(x)), os.path.join(ROOT, 'marke', 'livre.json'))
FEHLER_LOG = os.environ.get('LIVRE_FEHLER') or os.path.join(HIER, '_qa', 'fehler.jsonl')   # _qa geht nie online (werkzeuge_online.py WEG)
HOECHST_PIXEL = 120_000_000   # grösser liest die Prüfung nicht (Schutz vor Bildern, die beim Öffnen den Speicher sprengen)


@lru_cache(maxsize=1)
def _livre():
