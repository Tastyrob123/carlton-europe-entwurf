/* Le Livre · Carlton-Europe (von Hand). Kleid: Nacht, Papier und Messing, Jugendstil-CE, Tapete auf halber Deckkraft (Wert aus _werkbank/LIEFERUNGEN.md),
   Kopf jeder Ansicht als Bühne mit Foto des Hauses. Aufbau und Klassen wie Le Livre des Grand Beau-Rivage (Funktion 1:1), Gestaltung aus dem Haus.
   Bewegung nur über transform und opacity; Bilder bleiben beim Überfahren liegen. Eigene Klassen mit Vorsatz li-. */
@font-face{font-family:'Baskerville CE';font-weight:400 700;font-display:swap;src:url('../../assets/fonts/libre-baskerville-700.woff2') format('woff2')}
@font-face{font-family:'Baskerville Fein';font-weight:400;font-display:swap;src:url('../../assets/fonts/libre-baskerville-400.woff2') format('woff2')}
@font-face{font-family:'Instrument Sans';font-weight:400 600;font-display:swap;src:url('../../assets/fonts/InstrumentSans-normal-400_600.woff2') format('woff2')}
@font-face{font-family:'Montserrat CE';font-weight:600;font-display:swap;src:url('../../assets/fonts/montserrat-600-latin.woff2') format('woff2')}
@font-face{font-family:'DM Mono';font-weight:400;font-display:swap;src:url('../../assets/fonts/DMMono-normal-400.woff2') format('woff2')}
:root{--nacht:#06142b;--navy:#0b1f40;--blau:#12305e;--papier:#f4ecdc;--creme:#e8dbbf;--weiss:#fbf6ea;--gold:#dcc68f;--taupe:#8a7545;--tinte:#0c1526;
  --serif:'Baskerville Fein','Baskerville CE',Georgia,serif;--sans:'Instrument Sans',system-ui,-apple-system,'Segoe UI',sans-serif;--mono:'DM Mono',ui-monospace,Menlo,monospace;
  --e1:cubic-bezier(.16,1,.3,1);--e2:cubic-bezier(.32,.72,0,1);--feder:cubic-bezier(.28,1.42,.42,1);
  --kopf-h:72px;--rand-b:272px;--ok:#3d6b4f;--acht:#a07a22;--nein:#9c3b34;--leise:rgba(12,21,38,.66);--linie:rgba(138,117,69,.32)}
*{box-sizing:border-box}
html{scroll-behavior:auto}
body.li{margin:0;min-height:100vh;color:var(--tinte);font:17px/1.6 var(--sans);-webkit-font-smoothing:antialiased;
  background:linear-gradient(rgba(244,236,220,.5),rgba(244,236,220,.5)),url(../../assets/img/tapete.webp) 50% 0/1000px auto,var(--papier)}
body.li-zu{overflow:hidden}
button{font:inherit;color:inherit}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
:focus-visible{outline:2px solid var(--taupe);outline-offset:3px}
.mono{font:400 10.5px/1.4 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--taupe)}
.leise{color:var(--leise);font-size:.92rem;line-height:1.55;margin:.4em 0 0}
.link{border:0;background:none;padding:0;cursor:pointer;color:var(--taupe);text-decoration:underline;text-underline-offset:3px}
.li-ki,.mono,.kn{white-space:nowrap}

/* ---------- Kopf (oben), Rand (links), Leiste (unten) ---------- */
.kopf{position:fixed;z-index:50;left:0;right:0;top:0;height:var(--kopf-h);display:flex;align-items:center;gap:20px;padding:0 clamp(14px,2vw,28px);color:#fff;
  background:linear-gradient(rgba(11,31,64,.5),rgba(11,31,64,.5)),url(../../assets/img/tapete-navy.webp) 50% 0/700px auto,var(--navy);box-shadow:inset 0 -1px 0 rgba(220,198,143,.35),0 18px 30px -22px rgba(2,8,22,.8)}
.kopf__marke{display:flex;align-items:center;gap:12px;border:0;background:none;cursor:pointer;text-align:left;min-width:var(--rand-b);padding:0}
.kopf__marke b{display:block;font:400 1.35rem/1.05 var(--serif)}
.kopf__marke small{display:block;margin-top:2px;font:400 10px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:rgba(220,198,143,.85)}
.li-z{display:block;width:58px;flex:none;margin:-8px 0}
.li-z img{width:100%;height:auto;filter:drop-shadow(0 6px 8px rgba(0,0,0,.45))}
.kopf__mitte{flex:1;min-width:0;text-align:left}
.kopf__titel{font:400 1.2rem/1.2 var(--serif)}
.kopf__stand{font:400 10.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.62)}
.kopf__werk{display:flex;align-items:center;gap:10px}
.kopf__trenn{width:1px;height:28px;background:rgba(220,198,143,.4);margin:0 4px}
.rund{position:relative;display:grid;place-items:center;flex:none;width:42px;height:42px;border:0;border-radius:50%;cursor:pointer;color:var(--tinte);
  background:linear-gradient(180deg,#fbf3e2,#e8dbbf 50%,#cfbd98);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),inset 0 -2px 0 rgba(110,88,44,.36),0 10px 16px -10px rgba(0,0,0,.7);transition:transform .45s var(--e1)}
.rund:hover{transform:translateY(-2px)}.rund:active{transform:translateY(1px)}
.rund svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.rund[data-tip]::after{content:attr(data-tip);position:absolute;top:calc(100% + 10px);left:50%;translate:-50% 4px;padding:5px 11px;border-radius:999px;background:var(--tinte);color:var(--gold);font:500 10.5px var(--mono);letter-spacing:.12em;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .25s,translate .4s var(--e1)}
.rund:hover::after,.rund:focus-visible::after{opacity:1;translate:-50% 0}
.li-sp{position:relative}
.li-sp__k{display:flex;align-items:center;gap:8px;height:40px;padding:0 14px 0 16px;border:0;border-radius:999px;cursor:pointer;color:var(--gold);font:400 11px var(--mono);letter-spacing:.16em;
  background:linear-gradient(180deg,#1f3f77,#0b1f40 60%,#040d1e);box-shadow:inset 0 1px 0 rgba(255,255,255,.26),inset 0 -2px 0 rgba(0,0,0,.4),0 0 0 1px rgba(220,198,143,.4),0 10px 16px -10px rgba(0,0,0,.75)}
.li-sp__k i{display:grid;width:10px}.li-sp__k svg{width:10px;height:10px;fill:none;stroke:currentColor;stroke-width:1.4;transition:transform .4s var(--e1)}
.li-sp.offen .li-sp__k svg{transform:rotate(180deg)}
.li-sp ul{position:absolute;top:calc(100% + 10px);right:0;margin:0;padding:8px;list-style:none;min-width:200px;border-radius:18px;background:linear-gradient(180deg,#fffdf7,#f3ead6);box-shadow:inset 0 1px 0 #fff,inset 0 0 0 1px rgba(138,117,69,.3),0 30px 40px -20px rgba(0,0,0,.7);
  opacity:0;transform:translateY(-6px) scale(.98);transform-origin:top right;pointer-events:none;transition:opacity .25s,transform .45s var(--e1);z-index:80}
.li-sp.offen ul{opacity:1;transform:none;pointer-events:auto}
.li-sp li button{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;padding:10px 12px;border:0;border-radius:12px;background:none;cursor:pointer;font:400 1.05rem var(--serif);color:var(--tinte);text-align:start}
.li-sp li button small{font:400 10px var(--mono);letter-spacing:.14em;color:var(--taupe)}
.li-sp li button:hover,.li-sp li button[aria-selected="true"]{background:rgba(138,117,69,.14)}

.rand{position:fixed;z-index:40;left:0;top:var(--kopf-h);bottom:0;width:var(--rand-b);display:flex;flex-direction:column;gap:22px;padding:26px 16px 120px;overflow:auto;color:#fff;
  background:linear-gradient(rgba(11,31,64,.5),rgba(11,31,64,.5)),url(../../assets/img/tapete-navy.webp) 50% 0/700px auto,var(--navy);box-shadow:inset -1px 0 0 rgba(220,198,143,.2)}
.rand__auf{display:none}
.nav{display:flex;flex-direction:column;gap:8px}
.nav>p{margin:14px 6px 2px;font:400 10px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:rgba(220,198,143,.75)}
.nw{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:13px 16px;border:0;border-radius:14px;cursor:pointer;text-align:left;background:rgba(255,255,255,.04);box-shadow:inset 0 0 0 1px rgba(220,198,143,.14);
  font:400 1.06rem/1.2 var(--serif);color:#fff;transition:transform .5s var(--e1),background .3s}
.nw em{font:400 10.5px var(--mono);font-style:normal;letter-spacing:.1em;color:rgba(220,198,143,.85)}
.nw em svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.5}
.nw:hover{transform:translateX(3px);background:rgba(255,255,255,.08)}
.nw[aria-current="true"]{color:var(--tinte);background:linear-gradient(180deg,#fbf3e2,#e8dbbf 50%,#cfbd98);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),inset 0 -2px 0 rgba(110,88,44,.36),0 14px 20px -10px rgba(0,0,0,.7)}
.nw[aria-current="true"] em{color:var(--taupe)}
.wege{margin-top:auto;display:flex;flex-direction:column;gap:2px;border-top:1px solid rgba(220,198,143,.25);padding-top:14px}
.wege a{display:flex;align-items:center;justify-content:space-between;padding:9px 6px;font:400 .95rem var(--serif);color:rgba(255,255,255,.82);transition:color .3s,transform .4s var(--e1)}
.wege a:hover{color:var(--gold);transform:translateX(3px)}
.wege svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.4}

.haupt{margin-left:var(--rand-b);padding:calc(var(--kopf-h) + clamp(22px,2.6vw,38px)) clamp(18px,3.4vw,56px) 190px;min-height:100vh}
#ansicht>*{max-width:1240px;margin-left:auto;margin-right:auto}
.leiste{position:fixed;z-index:45;left:calc(var(--rand-b) + (100vw - var(--rand-b)) / 2);bottom:22px;translate:-50% 0;width:min(1180px,calc(100vw - var(--rand-b) - 44px));display:flex;align-items:center;gap:16px;padding:12px 12px 12px 22px;border-radius:18px;color:#fff;
  background:linear-gradient(rgba(11,31,64,.5),rgba(11,31,64,.5)),url(../../assets/img/tapete-navy.webp) 50% 0/700px auto,var(--navy);box-shadow:inset 0 0 0 1px rgba(220,198,143,.4),inset 0 0 0 5px var(--navy),inset 0 0 0 6px rgba(220,198,143,.18),0 28px 44px -20px rgba(2,8,22,.85)}
.li-recht__z{flex:none;width:46px}.li-recht__z img{width:100%;height:auto}
.leiste__t{flex:1;min-width:0;display:flex;flex-direction:column}
.leiste__t b{font:400 1.05rem/1.2 var(--serif)}
.leiste__t span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:.78rem;line-height:1.45;color:rgba(255,255,255,.7)}

/* ---------- Knöpfe, Platten ---------- */
.kn{--o:#1f3f77;--m:#0b1f40;--u:#040d1e;--t:#fff;--ko:#fbf3e2;--ku:#cfbd98;--kt:var(--tinte);position:relative;display:inline-flex;align-items:center;gap:14px;height:54px;padding:0 7px 0 24px;border:0;border-radius:999px;cursor:pointer;color:var(--t);
  font:500 11.5px var(--sans);letter-spacing:.16em;text-transform:uppercase;background:linear-gradient(180deg,var(--o),var(--m) 55%,var(--u));box-shadow:inset 0 1px 0 rgba(255,255,255,.26),inset 0 -3px 0 rgba(0,0,0,.4),0 18px 26px -14px rgba(6,20,43,.7);overflow:hidden;transition:transform .5s var(--e1),box-shadow .5s}
.kn i{flex:none;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:linear-gradient(180deg,var(--ko),var(--ku));color:var(--kt);box-shadow:inset 0 1px 0 #fff,inset 0 -2px 0 rgba(110,88,44,.4),0 3px 6px rgba(0,0,0,.35)}
.kn svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;transition:transform .5s var(--e2)}
.kn:hover{transform:translateY(-2px)}.kn:hover svg{transform:translate(2px,-2px)}.kn:active{transform:translateY(1px)}
.kn::after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 0%,rgba(255,255,255,.2) 50%,transparent 100%);transform:translateX(-120%);transition:transform .9s var(--e1)}
.kn:hover::after{transform:translateX(120%)}
.kn--klein{height:44px;padding-left:20px;font-size:10.5px;gap:10px}.kn--klein i{width:32px;height:32px}
.kn--linie{--o:#fffdf7;--m:#f6eedd;--u:#e0d2b6;--t:var(--tinte);--ko:#1e3c72;--ku:#050f22;--kt:#fff;box-shadow:inset 0 1px 0 #fff,inset 0 -3px 0 rgba(110,88,44,.28),inset 0 0 0 1px rgba(110,88,44,.16),0 16px 26px -14px rgba(74,58,26,.45)}
.kn--linie::after{background:linear-gradient(100deg,transparent,rgba(255,255,255,.8),transparent)}
.kn--gold{--o:#f8eac6;--m:#d6b679;--u:#aa874f;--t:var(--tinte);--ko:#1e3c72;--ku:#050f22;--kt:#fff;background:linear-gradient(180deg,#f8eac6 0%,#ead09a 20%,#d6b679 52%,#c2a062 80%,#aa874f 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 -3px 0 rgba(92,72,38,.4),0 16px 24px -14px rgba(0,0,0,.7)}
.platte{border-radius:30px;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:inset 0 1px 0 #fff,inset 0 0 0 1px rgba(138,117,69,.26),0 40px 56px -36px rgba(74,58,26,.7);color:var(--tinte)}

/* ---------- Auftritt: schwebt federnd herein, sobald im Bild ---------- */
.li [data-r]{transform:translate3d(0,46px,0) scale(.965)}   /* ab dem ersten Bild deckend, nur Bewegung (Robert 16.10.2026, wie Le Livre des Rivage) */
.li [data-r].da{animation:li-feder 1.15s var(--feder) calc(var(--i,0) * 70ms) both}
.li .li-f[data-r].da{animation-duration:.6s;animation-delay:calc(var(--i,0) * 35ms)}
@keyframes li-feder{0%{transform:translate3d(0,46px,0) scale(.965)}100%{transform:none}}
@media (prefers-reduced-motion:reduce){.li [data-r]{opacity:1;transform:none}.li [data-r].da{animation:none}}

/* ---------- Kopf jeder Ansicht: Bühne mit Foto des Hauses ---------- */
.li-hero{position:relative;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);align-items:end;gap:clamp(18px,3vw,50px);min-height:clamp(260px,26vw,360px);margin-bottom:clamp(22px,2.6vw,38px);padding:clamp(26px,3.2vw,48px) clamp(24px,3.4vw,54px);border-radius:30px;overflow:hidden;isolation:isolate;color:#fff;
  box-shadow:inset 0 0 0 1px rgba(220,198,143,.3),0 50px 70px -44px rgba(6,20,43,.85),0 12px 22px -14px rgba(6,20,43,.5)}
.li-hero__b{position:absolute;inset:0;z-index:-1;background:var(--bild) 50% 50%/cover no-repeat,var(--navy);transform-origin:70% 50%;animation:li-zoom 3.2s var(--e1) both}
@keyframes li-zoom{from{transform:scale(1.1)}to{transform:none}}
.li-hero__t{display:flex;flex-direction:column;align-items:flex-start;max-width:660px}
.li-hero__ce{display:block;width:clamp(96px,9vw,138px);margin:-24px 0 6px -12px;animation:li-ce 2.2s var(--feder) .15s both}
.li-hero__ce img{width:100%;height:auto}
@keyframes li-ce{from{transform:scale(.62) rotate(-14deg)}to{transform:none}}
.li-hero h1{margin:0;font:400 clamp(2rem,3.7vw,3.7rem)/1.08 var(--serif);letter-spacing:-.012em;text-shadow:0 .05em .2em rgba(4,10,24,.7)}
.li-zz{display:block;overflow:hidden;padding:0 0 .1em}
.li-zz>span{display:block;animation:li-zeile 1.5s var(--e1) both}
.li-zz:nth-child(1)>span{animation-delay:.25s}.li-zz:nth-child(2)>span{animation-delay:.4s}
@keyframes li-zeile{from{transform:translate3d(0,112%,0)}to{transform:none}}
.li-hero h1 em{font-style:normal;color:var(--gold)}
.li-hero .satz{margin:clamp(12px,1.4vw,20px) 0 0;max-width:48ch;font-size:clamp(.98rem,1.1vw,1.1rem);line-height:1.62;color:rgba(255,255,255,.88);text-shadow:0 1px 3px rgba(4,10,24,.8),0 4px 18px rgba(4,10,24,.7);animation:li-ein 1.4s var(--e1) .65s both}
@keyframes li-ein{from{transform:translate3d(0,26px,0)}to{transform:none}}
.titel__kn{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px;animation:li-ein 1.4s var(--e1) .8s both}
.li-hero__s{list-style:none;margin:0;padding:0;display:flex;justify-content:flex-end;gap:clamp(8px,1vw,16px);flex-wrap:nowrap}
.li-hero__s li{display:flex;flex-direction:column;align-items:center;min-width:92px;padding:14px 14px 12px;border-radius:18px;background:linear-gradient(180deg,rgba(20,48,90,.9),rgba(8,24,52,.92));box-shadow:inset 0 1px 0 rgba(255,255,255,.22),inset 0 0 0 1px rgba(220,198,143,.34),0 22px 30px -18px rgba(0,0,0,.8);animation:li-stat 1.6s var(--feder) both}
.li-hero__s li:nth-child(1){animation-delay:.7s}.li-hero__s li:nth-child(2){animation-delay:.84s}.li-hero__s li:nth-child(3){animation-delay:.98s}
@keyframes li-stat{from{transform:translate3d(0,46px,0) scale(.94)}to{transform:none}}
.li-hero__s b{font:400 clamp(1.7rem,2.6vw,2.5rem)/1 var(--serif);color:var(--gold);font-variant-numeric:lining-nums}
.li-hero__s span{margin-top:4px;font:400 10px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.76);text-align:center}
.li-hero[data-r].da{animation:none}
.li-hero[data-r]{opacity:1;transform:none}
@media (max-width:900px){.li-hero{grid-template-columns:minmax(0,1fr);min-height:0;align-items:start}.li-hero__s{justify-content:flex-start;flex-wrap:wrap}.li-hero__s li{min-width:92px}.li-hero__b::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,20,43,.5),rgba(6,20,43,.84))}}
@media (prefers-reduced-motion:reduce){.li-hero__b,.li-hero__ce,.li-zz>span,.li-hero .satz,.li-hero__s li,.titel__kn{animation:none!important}}

/* ---------- Übersicht ---------- */
.li-karten{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.li-k{position:relative;display:flex;flex-direction:column;padding:10px;border:0;border-radius:30px;text-align:start;cursor:pointer;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:inset 0 1px 0 #fff,inset 0 0 0 1px rgba(138,117,69,.26),0 40px 56px -36px rgba(74,58,26,.7);color:var(--tinte)}
.li-k__b{position:relative;display:block;aspect-ratio:4/3;border-radius:21px;overflow:hidden;background:var(--creme)}
.li-k__n{position:relative;display:flex;flex-direction:column;gap:4px;padding:18px 66px 14px 12px}
.li-k__n small{font:400 10px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--taupe)}
.li-k__n b{font:400 1.7rem/1.1 var(--serif);color:var(--navy)}
.li-k__n>span{color:var(--leise);font-size:.9rem;line-height:1.5}
.li-k__p{position:absolute;right:10px;top:18px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;color:var(--tinte);font-style:normal;background:linear-gradient(180deg,#fbf3e2,#cfbd98);box-shadow:inset 0 1px 0 #fff,inset 0 -2px 0 rgba(110,88,44,.4),0 8px 14px -8px rgba(9,17,39,.6);transition:transform .6s var(--e2)}
.li-k__p svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.5}
@media (hover:hover){.li-k:hover .li-k__p{transform:translateX(3px) scale(1.06)}}
.li-stapel{position:absolute;inset:0;background:linear-gradient(rgba(11,31,64,.5),rgba(11,31,64,.5)),url(../../assets/img/tapete-navy.webp) 0 0/300px auto,var(--navy)}
.li-stapel img{position:absolute;width:56%;aspect-ratio:4/3;object-fit:cover;border:6px solid #fbf6ea;border-radius:6px;box-shadow:0 18px 30px -14px rgba(0,0,0,.7)}
.li-stapel img:nth-child(1){left:7%;top:14%;transform:rotate(-7deg)}
.li-stapel img:nth-child(2){left:24%;top:30%;transform:rotate(3deg)}
.li-stapel img:nth-child(3){left:40%;top:12%;width:44%;aspect-ratio:3/4;transform:rotate(9deg)}
.li-logo{position:absolute;inset:0;display:grid;place-items:center}
.tapete-d{background:linear-gradient(rgba(11,31,64,.5),rgba(11,31,64,.5)),url(../../assets/img/tapete-navy.webp) 0 0/300px auto,var(--navy)}
.li-logo img{width:62%;height:auto;filter:drop-shadow(0 4px 12px rgba(0,0,0,.45))}
.li-pr-bild{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:20px;background:linear-gradient(rgba(244,236,220,.5),rgba(244,236,220,.5)),url(../../assets/img/tapete.webp) 0 0/300px auto,var(--papier)}
.li-pr-f{display:flex;height:66px;width:78%;border-radius:14px;overflow:hidden;box-shadow:0 0 0 1px rgba(138,117,69,.3),0 18px 26px -18px rgba(12,21,38,.6)}
.li-pr-f i{flex:1}
.li-pr-de{display:flex;align-items:baseline;gap:8px;color:var(--navy)}
.li-pr-de b{font:400 3.2rem/1 var(--serif)}.li-pr-de small{font:400 10px var(--mono);letter-spacing:.2em;color:var(--taupe)}
.li-zahlen{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:26px;padding:26px 10px}
.li-zahlen div{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;padding:0 10px}
.li-zahlen div+div{border-inline-start:1px solid var(--linie)}
.li-zahlen b{font:400 3rem/1 var(--serif);color:var(--navy);font-variant-numeric:lining-nums}
.li-zahlen span{font:400 10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--taupe)}
.li-buch{display:grid;grid-template-columns:220px 1fr auto;align-items:center;gap:26px;margin-top:26px;padding:10px 24px 10px 10px}
.li-buch__b{display:block;aspect-ratio:3/2;border-radius:19px;overflow:hidden}
.li-buch__b img{width:100%;height:100%;object-fit:cover}
.li-buch__t{display:flex;flex-direction:column;gap:5px}
.li-buch__t b{font:400 2rem/1.1 var(--serif);color:var(--navy)}
.li-buch__t>span{color:var(--leise)}

/* ---------- Bildarchiv ---------- */
.li-filter{padding:18px 22px 12px}
.suche{position:relative;display:block}
.suche input{width:100%;height:50px;padding:0 16px 0 44px;border:0;border-radius:16px;font:inherit;color:var(--tinte);background:#fffdf7;box-shadow:inset 0 2px 4px rgba(74,58,26,.18),inset 0 0 0 1px rgba(138,117,69,.3)}
.suche input:focus{outline:0;box-shadow:inset 0 2px 4px rgba(74,58,26,.18),inset 0 0 0 2px var(--taupe)}
.li-suche{margin:0 0 14px}
.li-suche svg{position:absolute;left:16px;top:17px;width:16px;height:16px;fill:none;stroke:var(--taupe);stroke-width:1.6}
.li-wahl{display:flex;align-items:center;gap:12px;margin:0 0 10px;flex-wrap:wrap}
.li-wahl .mono{min-width:78px}
.wahl2{display:flex;flex-wrap:wrap;gap:6px}
.wahl2 button{height:38px;padding:0 15px;border:0;border-radius:999px;cursor:pointer;font:400 .95rem var(--serif);color:var(--tinte);background:linear-gradient(180deg,#fffdf7,#f1e6cc);box-shadow:inset 0 1px 0 #fff,inset 0 -2px 0 rgba(110,88,44,.3),0 6px 10px -7px rgba(0,0,0,.5);transition:transform .4s var(--e1)}
.wahl2 button:hover{transform:translateY(-2px)}
.wahl2 button[aria-pressed="true"]{color:#fff;background:linear-gradient(180deg,#1f3f77,#0b1f40 60%,#040d1e);box-shadow:inset 0 1px 0 rgba(255,255,255,.26),inset 0 -2px 0 rgba(0,0,0,.4),0 8px 12px -8px rgba(0,0,0,.7)}
.li-wahl-reihe{display:flex;gap:10px 28px;flex-wrap:wrap}
.li-treffer{display:flex;justify-content:space-between;align-items:center;margin:8px 2px 0;font:400 10.5px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--taupe)}
.li-treffer .link{font:400 10.5px var(--mono);letter-spacing:.14em;text-transform:uppercase}
.li-raster{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));grid-auto-rows:152px;grid-auto-flow:dense;gap:16px;margin-top:24px}
.li-f{position:relative;display:block;padding:5px;border:0;border-radius:20px;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:0 0 0 1px rgba(138,117,69,.2),0 22px 34px -22px rgba(0,0,0,.6);cursor:zoom-in;transition:box-shadow .45s}
.li-f--hoch{grid-row:span 2}
.li-f img{display:block;width:100%;height:100%;object-fit:cover;border-radius:15px;background:var(--creme)}
.li-f--frei img{object-fit:contain;padding:8px}
.li-f:focus-visible,.li-f:hover{box-shadow:0 0 0 2px var(--taupe),0 0 0 7px rgba(138,117,69,.2),0 22px 34px -22px rgba(0,0,0,.6)}
/* Einkerbung: der Name in einer ausgeschnittenen Ecke unten links */
.li-f__n{position:absolute;left:5px;bottom:5px;max-width:calc(100% - 26px);padding:8px 14px 6px 12px;border-radius:0 16px 0 15px;background:#f4ecdc;font:400 .95rem/1.15 var(--serif);color:var(--navy);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transform:translateY(6px);transition:opacity .4s,transform .5s var(--e1)}
.li-f:hover .li-f__n,.li-f:focus-visible .li-f__n{opacity:1;transform:none}
@media (hover:none){.li-f__n{opacity:1;transform:none}}
.li-ki{position:absolute;top:13px;left:13px;padding:5px 9px 4px;border-radius:8px;background:var(--navy);color:var(--gold);font:400 9.5px var(--mono);letter-spacing:.16em;box-shadow:0 0 0 1px rgba(220,198,143,.55),0 6px 12px -6px rgba(0,0,0,.6)}
.li-leer{grid-column:1/-1;padding:60px 0;text-align:center;font:400 1.5rem var(--serif);color:var(--taupe)}
.li-mehr{display:flex;justify-content:center;margin-top:30px}

/* ---------- Detail im Fenster ---------- */
.fenster{position:fixed;inset:0;z-index:90;display:grid;place-items:center;padding:clamp(12px,3vw,40px);background:rgba(4,10,24,.84);overflow:auto}
.fenster[hidden]{display:none}
.fenster__k{position:relative;width:100%;max-height:100%;overflow:auto;padding:clamp(18px,2.4vw,34px);border-radius:28px;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:0 60px 90px -40px #000;animation:li-ein .7s var(--e1) both}
.fenster__zu{position:absolute;right:14px;top:14px;z-index:5}
.li-fk{width:min(1240px,100%)}
.li-det{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:32px;align-items:start}
.li-det__bild{position:relative;width:fit-content;max-width:100%;margin:0 auto;overflow:hidden;border-radius:18px;background:var(--creme);box-shadow:0 0 0 1px rgba(138,117,69,.25),0 26px 40px -26px rgba(0,0,0,.6);touch-action:none;line-height:0}
.li-det__bild>img:first-child{display:block;width:auto;max-width:100%;height:auto;max-height:70vh;user-select:none;-webkit-user-drag:none}
.li-rahmen{position:absolute;left:0;top:0;border:2px solid #f0e3c2;border-radius:6px;box-shadow:0 0 0 9999px rgba(8,16,34,.52),inset 0 0 0 1px rgba(0,0,0,.25);cursor:grab;z-index:2}
.li-rahmen.zieht{cursor:grabbing}
.li-rahmen--ganz{cursor:default}
.li-rahmen::after{content:attr(data-g);position:absolute;left:10px;top:10px;padding:5px 9px 4px;border-radius:8px;background:var(--navy);color:var(--gold);font:400 9px/1.2 var(--mono);letter-spacing:.16em;text-transform:uppercase;white-space:nowrap}
.li-rahmen.blitz{animation:li-blitz .7s ease-out}
@keyframes li-blitz{0%{border-color:#fff;box-shadow:0 0 0 9999px rgba(8,16,34,.52),0 0 24px rgba(255,248,226,.8)}100%{border-color:#f0e3c2}}
.li-det__hilfe{margin:12px 4px 0}
.li-det__t h2{margin:6px 0 14px;font:400 2.1rem/1.12 var(--serif);color:var(--navy)}
.li-meta{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:16px 0 20px;font-size:.88rem}
.li-meta dt{font:400 10px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--taupe);padding-top:3px}
.li-meta dd{margin:0}
.li-det__gr{margin:0 0 8px}
.li-grl{list-style:none;margin:0;padding:6px;border-radius:20px;background:rgba(138,117,69,.12);box-shadow:inset 0 2px 5px rgba(74,58,26,.16)}
.li-gr{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 8px 10px 14px;border-radius:15px;transition:background .35s,box-shadow .35s}
.li-gr+.li-gr{margin-top:2px}
.li-gr.an{background:linear-gradient(180deg,#fffdf8,#f4ead6);box-shadow:inset 0 1px 0 #fff,inset 0 0 0 1px rgba(152,115,60,.28),0 8px 14px -8px rgba(12,21,38,.35)}
.li-gr span{display:flex;flex-direction:column;gap:2px}
.li-gr b{font:400 1.15rem/1.1 var(--serif);color:var(--navy)}
.li-gr small{font-size:.8rem;color:var(--leise)}
.li-hinweis{margin:0 0 12px;padding:12px 16px;border-radius:14px;background:rgba(138,117,69,.12);box-shadow:inset 0 2px 5px rgba(74,58,26,.14);font-size:.88rem;color:var(--tinte)}
.li-hinweis b{display:block;margin-bottom:3px;font:400 10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--taupe)}
.li-hinweis--ki{background:linear-gradient(180deg,#14305a,#0b1f40);color:#f4ecdc;box-shadow:inset 0 0 0 1px rgba(220,198,143,.45)}
.li-hinweis--ki b{color:var(--gold)}
.li-hinweis--leise{background:none;box-shadow:none;padding:0;color:var(--leise)}
.li-hinweis--bsp{padding:14px 20px}
.li-orig{margin:14px 0 0}
.li-imp{margin-top:22px;padding-top:18px;border-top:1px solid var(--linie)}
.li-imp__k{display:flex;flex-wrap:wrap;gap:10px;margin:6px 0 8px}
/* Vorher / Nachher (nur im Carlton, nur bei den nachgeschärften Fotos) */
.li-vn__v{position:absolute;left:0;top:0;width:100%;height:100%;object-fit:fill;opacity:0;transition:opacity .6s ease;pointer-events:none;z-index:1;user-select:none}
.li-det__bild[data-m="vorher"] .li-vn__v{opacity:1}
.li-det__bild[data-m="schieber"] .li-vn__v{opacity:1;transition:none;clip-path:inset(0 calc(100% - var(--p,50%)) 0 0)}
.li-det__bild[data-m="schieber"]{cursor:ew-resize}
.li-det__bild:not([data-m="nachher"]) .li-rahmen{display:none}
.li-vn__gr{position:absolute;top:0;bottom:0;left:var(--p,50%);width:0;display:none;pointer-events:none;z-index:3}
.li-det__bild[data-m="schieber"] .li-vn__gr{display:block}
.li-vn__gr::before{content:'';position:absolute;top:0;bottom:0;left:-1px;width:2px;background:#fff;box-shadow:0 0 0 1px rgba(0,0,0,.25),0 0 14px rgba(0,0,0,.45)}
.li-vn__gr i{position:absolute;top:50%;left:0;width:46px;height:46px;margin:-23px 0 0 -23px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(180deg,#fbf3e2,#cfbd98);color:var(--tinte);box-shadow:inset 0 1px 0 #fff,0 10px 18px -6px rgba(0,0,0,.7)}
.li-vn__t{position:absolute;left:14px;top:14px;padding:6px 14px;border-radius:999px;background:rgba(6,20,43,.84);color:var(--gold);font:400 10.5px/1.2 var(--mono);letter-spacing:.14em;text-transform:uppercase;pointer-events:none;box-shadow:0 0 0 1px rgba(220,198,143,.3);z-index:4}
.li-det__bild[data-m="nachher"] .li-vn__t{top:auto;bottom:70px}
.li-vn__bar{position:absolute;left:50%;bottom:16px;translate:-50% 0;z-index:4;display:flex;gap:4px;padding:4px;border-radius:999px;background:rgba(6,20,43,.88);box-shadow:inset 0 0 0 1px rgba(220,198,143,.3),0 14px 22px -10px rgba(0,0,0,.8);line-height:1}
.li-vn__bar button{height:38px;padding:0 18px;border:0;border-radius:999px;cursor:pointer;font:500 10.5px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.82);background:none;transition:background .3s,color .3s}
.li-vn__bar button:hover{color:#fff}
.li-vn__bar button[aria-pressed="true"]{color:var(--tinte);background:linear-gradient(180deg,#fbf3e2,#e8dbbf 50%,#cfbd98);box-shadow:inset 0 1px 0 #fff,inset 0 -2px 0 rgba(110,88,44,.36)}

/* ---------- Dateien ---------- */
.li-d{margin-top:clamp(34px,4vw,60px)}
.li-d>header{margin-bottom:18px}
.li-d__t{margin:0;font:400 clamp(1.8rem,2.8vw,2.6rem)/1.1 var(--serif);color:var(--navy)}
.li-d__t em{font-style:normal;color:var(--taupe)}
.li-tafeln{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}
.li-tafeln--breit{grid-template-columns:repeat(auto-fill,minmax(340px,1fr))}
.li-tafel{margin:0;border-radius:24px;overflow:hidden;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:inset 0 0 0 1px rgba(138,117,69,.26),0 30px 44px -30px rgba(74,58,26,.7);display:flex;flex-direction:column}
.li-tafel__f{display:grid;place-items:center;aspect-ratio:1.5;padding:22px}
.li-tafel__f img{max-width:70%;max-height:100%;width:auto;height:auto}
.li-tafel--breit .li-tafel__f img,.li-tafeln--breit .li-tafel__f img{max-width:82%}
.li-tafel--dunkel .li-tafel__f{background:radial-gradient(70% 80% at 50% 38%,#1f4a8a 0%,#12305e 38%,#0a1d3f 72%,#06142b 100%)}
.li-tafel--hell .li-tafel__f{background:linear-gradient(rgba(244,236,220,.5),rgba(244,236,220,.5)),url(../../assets/img/tapete.webp) 50% 50%/420px auto,var(--papier)}
.li-tapete{background-size:300px auto!important;background-position:0 0!important;aspect-ratio:1.5}
.li-tafel figcaption{display:flex;flex-direction:column;gap:10px;padding:14px 18px 18px}
.li-tafel figcaption b{display:block;font:400 1.1rem/1.2 var(--serif)}
.li-tafel figcaption small{display:block;font:400 10px var(--mono);letter-spacing:.06em;color:var(--leise);margin-top:2px;overflow:hidden;text-overflow:ellipsis}
.li-kn{display:flex;flex-wrap:wrap;gap:8px}
.li-kn--mitte{justify-content:center;margin-top:22px}
.li-farben{display:grid;grid-template-columns:repeat(auto-fill,minmax(172px,1fr));gap:16px}
.li-farbe{position:relative;display:flex;flex-direction:column;border:0;padding:0;border-radius:20px;overflow:hidden;cursor:pointer;text-align:left;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:inset 0 0 0 1px rgba(138,117,69,.26),0 26px 36px -26px rgba(74,58,26,.7);transition:transform .6s var(--e1)}
.li-farbe:hover{transform:translateY(-5px)}
.li-farbe__f{position:relative;display:block;height:132px;background:var(--c);box-shadow:inset 0 -1px 0 rgba(0,0,0,.18)}
.li-farbe--glanz .li-farbe__f{box-shadow:inset 0 1px 0 rgba(255,255,255,.7),inset 0 -1px 0 rgba(70,52,26,.4)}
.li-farbe__ok{position:absolute;left:50%;top:50%;translate:-50% -50%;scale:.8;padding:6px 14px;border-radius:999px;background:var(--tinte);color:var(--gold);font:500 10.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;opacity:0;transition:opacity .3s,scale .5s var(--e1)}
.li-farbe.kopiert .li-farbe__ok{opacity:1;scale:1}
.li-farbe__n{display:flex;flex-direction:column;gap:2px;padding:12px 14px 4px}
.li-farbe__n b{font:400 1.1rem/1.2 var(--serif)}
.li-farbe__n small{font-size:.78rem;line-height:1.4;color:var(--leise)}
.li-farbe__w{display:flex;flex-direction:column;gap:2px;padding:6px 14px 14px;font:400 10.5px var(--mono);letter-spacing:.04em;color:rgba(12,21,38,.7)}
.li-farbe__w span:hover{color:var(--taupe)}
.li-schriften{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.li-schrift{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) auto;gap:20px;align-items:center;padding:14px 16px 14px 24px;border-radius:20px;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:inset 0 0 0 1px rgba(138,117,69,.26),0 20px 30px -24px rgba(74,58,26,.6)}
.li-schrift__p{font-size:clamp(1.2rem,2vw,1.8rem);line-height:1.2;color:var(--navy);overflow-wrap:anywhere}
.li-schrift b{display:block;font:400 1.05rem var(--serif)}
.li-schrift small{font-size:.8rem;color:var(--leise)}
.f-a{font-family:'Baskerville Fein','Baskerville CE',serif}
.f-n{font-family:'Baskerville CE',serif;font-weight:700;letter-spacing:.14em}
.f-o{font-family:'Montserrat CE',var(--sans);font-weight:600;letter-spacing:.24em;font-size:1rem!important}
.f-s{font-family:var(--sans)}

/* ---------- Markenprüfung ---------- */
.li-feld{padding:clamp(20px,2.6vw,34px)}
.li-feld__in{display:flex;flex-direction:column;align-items:center;gap:12px;padding:clamp(28px,4vw,56px) 20px;border:2px dashed rgba(138,117,69,.5);border-radius:22px;text-align:center;transition:background .3s,border-color .3s}
.li-feld.ueber .li-feld__in{background:rgba(220,198,143,.2);border-color:var(--taupe)}
.li-feld__z{width:84px}.li-feld__z img{width:100%;height:auto}
.li-feld__t{margin:0;font:400 1.6rem var(--serif);color:var(--navy)}
.li-feld__vor{width:min(260px,70%);aspect-ratio:4/3;border-radius:14px;overflow:hidden;background:var(--creme);display:grid;place-items:center;box-shadow:0 20px 30px -18px rgba(0,0,0,.5)}
.li-feld__vor img{width:100%;height:100%;object-fit:contain}
.li-pdf{font:400 1.4rem var(--mono);color:var(--taupe)}
.li-feld__name{margin:0}.li-feld__name b{display:block;font-family:var(--serif);font-weight:400;font-size:1.2rem}.li-feld__name small{color:var(--leise)}
.li-feld__kn{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:8px}
.li-bsp{margin:6px 0 0}
.li-privat{margin:16px 6px 0;text-align:center;font-size:.85rem;color:var(--leise)}
.li-lauf{display:grid;grid-template-columns:minmax(0,320px) 1fr;gap:clamp(20px,3vw,44px);align-items:center;padding:clamp(20px,2.6vw,34px)}
.li-lauf__b{position:relative;border-radius:16px;overflow:hidden;background:var(--creme);aspect-ratio:4/3;display:grid;place-items:center}
.li-lauf__b img{width:100%;height:100%;object-fit:contain}
.li-scan{position:absolute;left:0;right:0;top:0;height:30%;background:linear-gradient(180deg,transparent,rgba(220,198,143,.55),transparent);animation:li-scan 2.4s ease-in-out infinite}
@keyframes li-scan{0%{transform:translateY(-100%)}100%{transform:translateY(340%)}}
.li-schritte{list-style:none;margin:0 0 10px;padding:0;display:grid;gap:12px}
.li-schritte li{display:flex;align-items:center;gap:14px;font:400 1.2rem var(--serif);color:rgba(12,21,38,.45);transition:color .4s}
.li-schritte i{flex:none;width:18px;height:18px;border-radius:50%;box-shadow:inset 0 0 0 2px currentColor;position:relative}
.li-schritte li.an{color:var(--navy)}
.li-schritte li.an i{animation:li-puls 1.1s ease-in-out infinite}
.li-schritte li.fertig{color:var(--ok)}
.li-schritte li.fertig i{background:var(--ok);box-shadow:none}
@keyframes li-puls{50%{transform:scale(.7)}}
.li-erg{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.3fr);gap:clamp(18px,2.6vw,36px);align-items:start}
.li-erg__l,.li-erg__r{display:grid;gap:18px;min-width:0;grid-template-columns:minmax(0,1fr)}.li-erg,.li-pk,.li-gesamt{overflow-wrap:anywhere}.li-pk>*{min-width:0}
.li-erg__bild{margin:0;padding:12px}
.li-erg__bild img{width:100%;border-radius:18px}
.li-erg__bild figcaption{padding:12px 10px 4px}.li-erg__bild figcaption b{display:block;font:400 1.1rem var(--serif);overflow-wrap:anywhere}.li-erg__bild small{color:var(--leise)}
.li-erg__farben{padding:22px}
.li-erg__farben h3,.li-tonvor h3,.li-erg__h{margin:0 0 6px;font:400 1.4rem/1.2 var(--serif);color:var(--navy)}
.li-rahmen-z{display:flex;align-items:center;gap:12px;margin:14px 0;font-size:.88rem}
.li-rahmen-z__b{flex:none;width:90px;height:8px;border-radius:4px;background:rgba(12,21,38,.12);overflow:hidden}.li-rahmen-z__b i{display:block;height:100%;background:linear-gradient(90deg,#c9a764,#8a7545)}
.li-toene{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.li-ton{display:grid;grid-template-columns:34px 1fr auto;gap:4px 12px;align-items:center;padding:8px 0;border-top:1px solid var(--linie)}
.li-ton__f{width:34px;height:34px;border-radius:9px;box-shadow:0 0 0 1px rgba(12,21,38,.14)}
.li-ton__a{grid-column:2;display:flex;align-items:center;gap:10px;font:400 11px var(--mono)}.li-ton__a i{display:block;height:6px;border-radius:3px;background:var(--taupe);max-width:120px}
.li-ton__n{grid-column:2}.li-ton__n b{font:400 11px var(--mono);letter-spacing:.06em}.li-ton__n small{display:flex;align-items:center;gap:6px;font-size:.78rem;color:var(--leise)}.li-ton__n small i{width:12px;height:12px;border-radius:3px;display:inline-block;box-shadow:0 0 0 1px rgba(12,21,38,.2)}
.li-ton em{grid-column:3;grid-row:1/span 2;font:400 10px var(--mono);font-style:normal;letter-spacing:.12em;text-transform:uppercase}
.li-ton--gleich em{color:var(--ok)}.li-ton--nah em{color:var(--acht)}.li-ton--fremd em{color:var(--nein)}
.li-sonder{margin:14px 0 0;padding:12px 16px;list-style:none;border-radius:14px;background:rgba(138,117,69,.12);font-size:.85rem}
.li-gesamt{padding:22px 26px}.li-gesamt__s{margin:8px 0 0;font:400 1.5rem/1.35 var(--serif);color:var(--navy)}
.li-punkte{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.li-pk{display:grid;grid-template-columns:118px 1fr;gap:16px;padding:16px 18px;border-radius:20px;background:linear-gradient(180deg,#fffdf7,#f6eedb);box-shadow:inset 0 0 0 1px rgba(138,117,69,.26),0 20px 30px -24px rgba(74,58,26,.6)}
.li-pk__m{display:flex;flex-direction:column;gap:3px}.li-pk__m em{font:400 10.5px var(--mono);font-style:normal;letter-spacing:.14em;text-transform:uppercase}.li-pk__m small{font:400 10px var(--mono);letter-spacing:.1em;color:var(--leise);text-transform:uppercase}
.li-pk--passt .li-pk__m em{color:var(--ok)}.li-pk--achten .li-pk__m em{color:var(--acht)}.li-pk--passt_nicht .li-pk__m em{color:var(--nein)}
.li-pk--passt_nicht{box-shadow:inset 3px 0 0 var(--nein),inset 0 0 0 1px rgba(138,117,69,.26),0 20px 30px -24px rgba(74,58,26,.6)}
.li-pk__t b{display:block;font:400 1.15rem/1.25 var(--serif)}.li-pk__t span{display:block;margin-top:3px;font-size:.92rem;color:rgba(12,21,38,.8)}
.li-tonvor{padding:22px 26px}.li-tonvor ul{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:12px}.li-tonvor s{display:block;color:var(--leise)}.li-tonvor span{display:block;font:400 1.1rem/1.4 var(--serif);color:var(--navy)}
.li-gelesen{padding:6px 4px}.li-gelesen summary{cursor:pointer}.li-gelesen p{white-space:pre-wrap;font-size:.9rem}
.li-erg__kn{display:flex;flex-wrap:wrap;gap:12px}
.li-bsp-unten{margin-top:clamp(30px,4vw,56px);padding-top:clamp(24px,3vw,40px);border-top:1px solid var(--linie)}

/* ---------- Meldung, Laden ---------- */
.meldung{position:fixed;z-index:120;left:50%;bottom:112px;translate:-50% 0;display:grid;gap:8px;justify-items:center;pointer-events:none}
.quit{padding:11px 22px;border-radius:999px;background:var(--tinte);color:var(--gold);font:500 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;box-shadow:0 0 0 1px rgba(220,198,143,.4),0 20px 30px -14px rgba(0,0,0,.8);animation:li-ein .5s var(--e1) both}
.quit.fehl{background:#4a1d1a;color:#ffd9d2}
.lade{display:grid;place-items:center}
.lade__r{width:46px;height:46px;border-radius:50%;border:3px solid rgba(138,117,69,.25);border-top-color:var(--taupe);animation:li-dreh 1s linear infinite}
@keyframes li-dreh{to{transform:rotate(360deg)}}

/* ---------- Schmale Bildschirme ---------- */
@media (max-width:1100px){.li-karten{grid-template-columns:repeat(2,minmax(0,1fr))}.li-erg{grid-template-columns:minmax(0,1fr)}.li-det{grid-template-columns:minmax(0,1fr)}.li-buch{grid-template-columns:160px 1fr}.li-buch .kn{grid-column:1/-1;justify-self:start}}
@media (max-width:900px){
  :root{--rand-b:0px;--kopf-h:64px}
  .kopf{gap:10px}.kopf__marke{min-width:0}.kopf__marke small,.kopf__mitte,.kopf__trenn,.kopf__werk .kn{display:none}.li-z{width:48px}
  .rand{left:0;right:0;top:var(--kopf-h);bottom:auto;width:auto;max-height:calc(100vh - var(--kopf-h));padding:10px 14px;gap:10px;box-shadow:0 18px 30px -22px rgba(2,8,22,.8)}
  .rand__auf{display:flex;align-items:center;justify-content:space-between;width:100%;height:46px;border:0;border-radius:14px;cursor:pointer;padding:0 16px;background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1px rgba(220,198,143,.2);font:400 1.1rem var(--serif);color:#fff}
  .rand__auf i{width:10px;height:10px;border-right:1.6px solid var(--gold);border-bottom:1.6px solid var(--gold);transform:rotate(45deg);transition:transform .4s}
  .rand.auf .rand__auf i{transform:rotate(-135deg)}
  .rand .nav,.rand .wege{display:none}.rand.auf .nav,.rand.auf .wege{display:flex}
  .haupt{margin-left:0;padding-top:calc(var(--kopf-h) + 70px)}
  .leiste{left:50%;width:calc(100vw - 24px);bottom:12px;padding:10px 10px 10px 14px}.leiste__t span{-webkit-line-clamp:1}.li-recht__z{width:34px}
  .li-zahlen{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:20px}.li-zahlen div+div{border-inline-start:0}
}
@media (max-width:640px){
  .li-karten{grid-template-columns:minmax(0,1fr)}
  .li-raster{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:120px;gap:12px}
  .li-lauf{grid-template-columns:minmax(0,1fr)}.li-pk{grid-template-columns:minmax(0,1fr)}
  .li-schrift{grid-template-columns:minmax(0,1fr)}.li-buch{grid-template-columns:minmax(0,1fr)}
  .leiste .kn{padding:0 6px 0 14px;font-size:9.5px}.leiste__t b{font-size:.95rem}
  .li-wahl .mono{min-width:0;width:100%}
  .li-vn__bar button{padding:0 12px;height:34px;font-size:9.5px}
}
.li-erg .mono,.li-gesamt .mono,.li-pk .mono{white-space:normal}

/* ---------------------------------------------------------------- Prüfung 16.10.2026 */
/* R15: Ladezeichen erst nach 280 ms; braucht der Start ungewöhnlich lange, steht nach 12 s ein Satz da (falls livre.js gar nicht lädt) */
#ansicht > .lade .lade__r{opacity:0;animation:li-dreh 1s linear infinite,li-lade-da 0s .28s forwards}
#ansicht > .lade::after{content:'Le Livre lädt noch. Dauert es länger, bitte die Seite neu laden.';margin-top:22px;font:400 1rem/1.5 var(--sans,system-ui);color:var(--taupe,#8a7545);opacity:0;animation:li-lade-da 0s 12s forwards}
html[lang=en] #ansicht > .lade::after{content:'Le Livre is still loading. If it takes longer, please reload the page.'}
html[lang=fr] #ansicht > .lade::after{content:'Le Livre est encore en cours de chargement. Si cela dure, rechargez la page.'}
@keyframes li-lade-da{to{opacity:1}}
/* R04: Startfehler-Tür */
.li-tuer{max-width:620px;margin:12vh auto 0;padding:42px 44px 38px;text-align:center}
.li-tuer__z{display:block;width:74px;margin:0 auto 18px}
.li-tuer__z img{width:100%;height:auto;display:block}
.li-tuer h1{font:400 clamp(1.7rem,3vw,2.3rem)/1.2 var(--serif);margin:0 0 12px}
.li-tuer p{margin:0 0 10px;color:var(--tinte,#0c1526)}
.li-tuer__g{font:500 .95rem/1.5 var(--sans,system-ui);color:var(--taupe,#8a7545)}
.li-tuer .titel__kn{justify-content:center;margin-top:22px;display:flex;gap:12px;flex-wrap:wrap}
@media (max-width:600px){.li-tuer{padding:30px 22px 26px;margin-top:6vh}}
/* 320 px (Prüfung 16.10.2026): Tafeln der Querform und die zwei Knöpfe im Kopf liefen 31 px über den Rand */
@media (max-width:380px){
  .li-tafeln,.li-tafeln--breit{grid-template-columns:minmax(0,1fr)}
  .li-tafel,.li-tafel figcaption,.li-tafel figcaption > span{min-width:0}
  .li-hero .titel__kn{flex-direction:column;align-items:stretch}
  .li-hero .titel__kn .kn{max-width:100%;justify-content:space-between}
}

/* Robert 18.10.2026 13:40: «die gemessenen farben … so richtig edel professionell darstellen»: oben ein Farbband mit den Anteilen, darunter ein ruhiges Raster */
.li-band{display:flex;height:22px;margin:14px 0 8px;border-radius:11px;overflow:hidden;box-shadow:0 0 0 1px rgba(12,21,38,.12)}.li-band i{display:block;min-width:2px}
.li-erg__farben .li-rahmen-z{margin:0 0 14px;font:400 1rem/1.35 var(--serif);color:var(--navy)}
.li-erg__farben .li-toene{grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 16px}
.li-erg__farben .li-ton{grid-template-columns:26px minmax(0,1fr);gap:1px 10px;padding:8px 0;align-items:start}
.li-erg__farben .li-ton__f{width:26px;height:26px;border-radius:7px;grid-row:1/span 2}
.li-erg__farben .li-ton__n{grid-column:2}.li-erg__farben .li-ton__n b{font-size:10.5px}.li-erg__farben .li-ton__n small{font-size:.74rem;flex-wrap:wrap}
.li-erg__farben .li-ton em{grid-column:2;grid-row:auto;font-size:9.5px}
@media (max-width:520px){.li-erg__farben .li-toene{grid-template-columns:1fr}}
.li-erg__farben .li-ton__z{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.li-erg__farben .li-ton__n small{display:flex;flex-wrap:nowrap;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.li-erg__farben .li-ton em{font-size:9px;flex:none}
.li-erg__farben .li-ton{padding:7px 0}.li-erg__farben .li-ton__f{grid-row:auto}
.li-legende{margin:-6px 0 6px;font:400 10px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--leise)}

/* Ecke oben links genau wie Le Bureau (Robert 18.10.2026 17:36, Werkzeug-Master M24): Zeichen 42 px, Name in Gold-Versalien 15 px, darunter «Bereich · Carlton-Europe» */
.kopf__marke{display:flex!important;flex-direction:row!important;align-items:center!important;gap:13px!important;text-decoration:none!important;}
.kopf__marke .ecke__ce,.kopf__marke .li-z,.kopf__marke .li-z img{width:42px!important;height:auto!important;flex:none;display:block;margin:0!important;filter:drop-shadow(0 1px 0 rgba(61,42,16,.9)) drop-shadow(0 3px 8px rgba(0,0,0,.55))}
.kopf__marke .li-z img{filter:none}
.kopf__marke b{display:block!important;margin:0!important;font:400 15px/1.1 'Baskerville CE',Georgia,serif!important;letter-spacing:.24em!important;text-transform:uppercase!important;text-align:left;
  background:linear-gradient(180deg,#fbf0cf 0%,#ead39c 34%,#c9a764 52%,#9c7b43 62%,#dcc189 80%,#f3e3b6 100%);-webkit-background-clip:text;background-clip:text;color:transparent!important;-webkit-text-fill-color:transparent;filter:drop-shadow(0 1px 0 rgba(0,0,0,.6))}
.kopf__marke small{display:block!important;margin:6px 0 0!important;font:9.5px/1 'DM Mono',ui-monospace,Menlo,monospace!important;letter-spacing:.26em!important;text-transform:uppercase!important;color:rgba(240,227,194,.7)!important;text-align:left}

/* Farben in einer Reihe (Robert 18.10.2026 17:36: «so Farben max. eine Reihe nie 2», Werkzeug-Master M25): neun Töne und drei Verläufe nebeneinander,
   kleinere Felder; am Handy eine Reihe zum seitlichen Schieben */
.li-farben{grid-template-columns:repeat(12,minmax(0,1fr))!important;gap:8px!important}
.li-farben .li-farbe{border-radius:14px}
.li-farben .li-farbe__f{height:96px}
.li-farben .li-farbe__n{padding:9px 9px 2px}
.li-farben .li-farbe__n b{font-size:.84rem;line-height:1.15}
.li-farben .li-farbe__n small{font-size:.64rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.li-farben .li-farbe__w{padding:4px 9px 10px;font-size:9px}
.li-farben .li-farbe__w span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.li-farben .li-farbe__w span+span{display:none}
@media (max-width:820px){.li-farben{display:flex!important;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px;overscroll-behavior-x:contain}
  .li-farben .li-farbe{flex:0 0 118px;scroll-snap-align:start}}

/* Lage exakt wie Le Bureau (CE bei 22/22) */
.kopf__marke{margin-left:-6px!important}
